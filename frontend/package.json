{
  "name": "better-mas-tools-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.3",
  "description": "更好的MAS工具包独立前端",
  "license": "AGPL-3.0-or-later",
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 37165 --strictPort",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "oxlint src electron vite.config.ts electron-builder.cjs --max-warnings 0",
    "format": "oxfmt src electron vite.config.ts electron-builder.cjs",
    "test": "vitest run",
    "openapi": "openapi --input ./openapi.json --output ./src/api --client axios --useUnionTypes",
    "desktop": "electron .",
    "package:desktop": "electron-builder --config electron-builder.cjs --win --x64 --publish never"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "4.x",
    "axios": "1.15.2",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.17",
    "vue-i18n": "^11.4.10",
    "vue-router": "4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "22.17.1",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^37.2.5",
    "electron-builder": "26.8.1",
    "openapi-typescript-codegen": "^0.29.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.4",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.12"
  },
  "main": "dist-electron/main.cjs"
}
