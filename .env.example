# Better-MAS-Tools 本地环境模板
# 复制为项目根目录 .env；留空表示不覆盖系统环境变量。
# 密钥、账号和真实令牌不得提交。

# 本地后端/桌面运行（环回模式可全部留空）
COMMUNITY_REMOTE=
COMMUNITY_PUBLIC_ORIGIN=
COMMUNITY_ACCESS_PASSWORD=
COMMUNITY_ENCRYPTION_KEY=
COMMUNITY_DATA_DIR=
COMMUNITY_WEB_DIR=

# Android 构建工具链（仅构建 APK 时需要）
JAVA_HOME=
ANDROID_SDK_ROOT=
ANDROID_HOME=
GRADLE_USER_HOME=

# Worker 锁文件生成（仅重新生成 deploy/worker/pylock.toml 时需要）
WORKER_PYTHON=

# 开发规范与报告（仅开发流程使用）
AUTO_MAS_ROOT=
BETTER_MAS_DEV_REPORT=

# Cloudflare CLI/Actions（仅远端发布时需要）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PUBLIC_ORIGIN=
CLOUDFLARE_ACCESS_PASSWORD=
CLOUDFLARE_ENCRYPTION_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
